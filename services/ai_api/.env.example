# Development defaults use deterministic embeddings and a non-production model.
AI_API_ENVIRONMENT=development
AI_API_LOG_LEVEL=INFO
AI_API_CORS_ORIGINS=http://localhost:5173
AI_API_PREDICTOR_BACKEND=deterministic
AI_API_EMBEDDING_BACKEND=hash
AI_API_RAG_CORPUS_PATH=services/ai_api/data/demo_corpus.jsonl

# Production must use a registered model artifact and a sentence-transformer.
# AI_API_ENVIRONMENT=production
# AI_API_PREDICTOR_BACKEND=legacy_tft
# AI_API_MODEL_DIR=/mnt/models/tft_v3
# AI_API_EMBEDDING_BACKEND=sentence_transformer
# AI_API_EMBEDDING_MODEL_NAME=jhgan/ko-sroberta-multitask
